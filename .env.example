# Modelo para desenvolvimento local: copie para ".env" e preencha os valores.
# Na Vercel este arquivo NAO e carregado em runtime. Cadastre as mesmas chaves
# em Project > Settings > Environment Variables e faca Redeploy apos mudancas.
#
# Um projeto Vercel por shopping: estas 5 variaveis mudam a cada shopping.
# Ver README.md para o significado de cada rota e como ligar no wp-config.php.

INTRANETMALL_API_BASE_URL=https://www.intranetmall.com/ApiVagasCurriculum/api
INTRANETMALL_LOGIN=YOUR_LOGIN
INTRANETMALL_PASSWORD=YOUR_PASSWORD
INTRANETMALL_GROUP=YOUR_GROUP
INTRANETMALL_SHOPPING_CODE=YOUR_SHOPPING_CODE

# Chave que o WordPress manda no header x-relay-key. Pode ser a mesma nos 12 projetos.
RELAY_KEY=YOUR_RELAY_KEY

# Cache do token de login (ms). Padrão 720000 (12 min). 0 = novo login em toda requisição.
# INTRANETMALL_TOKEN_CACHE_TTL_MS=720000
