# Modelo para desenvolvimento local: copie para ".env" e preencha os valores.
# Na Vercel este arquivo NAO e carregado em runtime. Cadastre a mesma chave
# em Project > Settings > Environment Variables e faca Redeploy apos mudancas.
#
# Um unico projeto Vercel atende todos os shoppings: as credenciais de cada um
# (login, senha, grupo, shopping) vem por header a cada chamada, mandadas pelo
# proprio WordPress (ver README.md). So a chave abaixo mora no servidor.

# Chave que o WordPress manda no header x-relay-key. A mesma em todos os 12 sites.
RELAY_KEY=YOUR_RELAY_KEY

# Opcional: sobrescreve a base da API (padrão: https://www.intranetmall.com/ApiVagasCurriculum/api)
# INTRANETMALL_API_BASE_URL=https://app4.intranetmall.com/ApiVagasCurriculum/api

# Opcional: cache do token de login (ms), por shopping. Padrão 720000 (12 min).
# INTRANETMALL_TOKEN_CACHE_TTL_MS=720000
